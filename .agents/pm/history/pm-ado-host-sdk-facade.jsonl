{"hash_algorithm":"sha256","ts":"2026-10-27T01:55:53.323Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"897c90c1b80c3e3bf21a36a6","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-ado-host-sdk-facade"},{"op":"add","path":"/metadata/title","value":"Expose host-bound SDK primitives for extensions without a module link"},{"op":"add","path":"/metadata/description","value":"Pinned SDK 2026.10.23 exports commitItemMutations in sdk/item-transaction.d.ts:219, but core/extensions/extension-types.d.ts:574 ExtensionCommandSdk exposes only the bound client, graph helpers, workspace transactions and settings mutation. Missing signature: ExtensionCommandSdk.runtime (the installed public SDK namespace), or equivalent host-bound mutation/history/lease primitives including commitItemMutations(options without pmRoot). A manually copied extension whose pm install SDK link is removed cannot resolve those required primitives from its package anchor. Guarded sync now refuses clearly with ADO_USAGE and asks for pm install; read-only refresh still works. No local guard implementation or inferred launcher path is used. Proper package installs retain their SDK link. Searched the installed declarations and open upstream issues for ExtensionCommandSdk commitItemMutations; no matching open issue was returned. Orchestrator should verify current host APIs and file upstream if still missing; no upstream write performed."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["sdk-gap"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-27T01:55:53.323Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-27T01:55:53.323Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/parent","value":"pm-ado-sdk-adoption"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"39129b150655306e974e1a9cb6a3342d4bd924adf59fa4aef0d78e05bd669ad6","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"567502733c46d5106e449d326009c544afaa596a2fdeed3fce2fb4ef208b6d57"}
