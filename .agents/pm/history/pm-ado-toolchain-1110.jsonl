{"hash_algorithm":"sha256","ts":"2026-11-10T12:41:17.101Z","author":"codex-toolchain-1110","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"f87fd5b0b2ab058fa67597cf","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-10T12:41:17.101Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-10T12:41:17.100Z","author":"codex-toolchain-1110","text":"Installed CHANGELOG 2026.11.5 identifies GH-1655 (pm-gh1655): explicit typed null-clear semantics distinguish create from update, including update-only closeReason:null. Issue 98 correctly diagnoses pmFields returning the full update shape and spreading it into create; unset:undefined did not narrow closeReason. Added a create mapper whose actual field subset excludes null clears and unset, plus an update mapper retaining assignment clearing and close finalization. Compiler fixtures accept new-item fields directly in public PmClient.create and reject update-only clears at that boundary."}]}],"before_hash":"5c8f153f6f337df4f3aef076d95bb1311de065ffe487f2d9fcf6deaea751a2ce","after_hash":"3b4fa6657c541c83dd6c5360bcc30984dfcfa77169cb1fcf92358b964c690c24","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"6b42cc49ac11615d351572b5002856f61b01621705dd3da1fd27090487209c83"}
