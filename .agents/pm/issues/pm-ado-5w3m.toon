  "npm run release:check",project,codex-sol,"2026-10-07T21:00:44.051Z",local_mutation,fix/statement-coverage-threshold
  "bun run release:check",project,codex-sol,"2026-10-07T21:00:44.630Z",local_mutation,fix/statement-coverage-threshold
